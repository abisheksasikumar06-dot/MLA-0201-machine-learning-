      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Training data\n",
        "data = pd.DataFrame([\n",
        "    ['Sunny','Warm','Normal','Strong','Warm','Same','Yes'],\n",
        "    ['Sunny','Warm','High','Strong','Warm','Same','Yes'],\n",
        "    ['Rainy','Cold','High','Strong','Warm','Change','No'],\n",
        "    ['Sunny','Warm','High','Weak','Cool','Change','Yes']\n",
        "], columns=['Sky','Temp','Humidity','Wind','Water','Forecast','Sport'])\n",
        "\n",
        "# Initialize S and G\n",
        "S = ['Ø'] * 6\n",
        "G = [['?'] * 6]\n",
        "\n",
        "# Candidate-Elimination\n",
        "for _, row in data.iterrows():\n",
        "    x, y = list(row[:-1]), row[-1]\n",
        "\n",
        "    if y == 'Yes':\n",
        "        for i in range(6):\n",
        "            if S[i] == 'Ø':\n",
        "                S[i] = x[i]\n",
        "            elif S[i] != x[i]:\n",
        "                S[i] = '?'\n",
        "\n",
        "        G = [g for g in G\n",
        "             if all(g[i] == '?' or g[i] == x[i] for i in range(6))]\n",
        "\n",
        "    else:\n",
        "        newG = []\n",
        "        for g in G:\n",
        "            for i in range(6):\n",
        "                if g[i] == '?' and S[i] != x[i]:\n",
        "                    h = g.copy()\n",
        "                    h[i] = S[i]\n",
        "                    newG.append(h)\n",
        "        G = newG\n",
        "\n",
        "print(\"Specific Boundary (S):\", S)\n",
        "print(\"General Boundary (G):\", G)\n",
        "\n",
        "# Matplotlib\n",
        "plt.plot(range(6), [0 if x == 'Ø' else 1 if x != '?' else 2 for x in S],\n",
        "         marker='o', label='S Boundary')\n",
        "\n",
        "for g in G:\n",
        "    plt.plot(range(6), [0 if x == 'Ø' else 1 if x != '?' else 2 for x in g],\n",
        "             marker='s', linestyle='--')\n",
        "\n",
        "plt.xticks(range(6), data.columns[:-1])\n",
        "plt.yticks([0,1,2], ['Ø', 'Specific', '?'])\n",
        "plt.title(\"Candidate-Elimination Algorithm\")\n",
        "plt.xlabel(\"Attributes\")\n",
        "plt.ylabel(\"Hypothesis\")\n",
        "plt.grid(True)\n",
        "plt.show()"
      ],
