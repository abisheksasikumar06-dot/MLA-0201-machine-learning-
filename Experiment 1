        "# FIND-S Algorithm\n",
        "# Machine Learning Lab\n",
        "# Works directly in Google Colab\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ---------------------------------------------------\n",
        "# STEP 1: Create the training dataset\n",
        "# ---------------------------------------------------\n",
        "\n",
        "data = {\n",
        "    'Sky':    ['Sunny', 'Sunny', 'Rainy', 'Sunny', 'Sunny'],\n",
        "        'AirTemp':['Warm',  'Warm',  'Cold',  'Warm',  'Warm'],\n",
        "            'Humidity':['Normal', 'High', 'High', 'High', 'Normal'],\n",
        "                'Wind':   ['Strong', 'Strong', 'Strong', 'Weak', 'Weak'],\n",
        "                    'Water':  ['Warm', 'Warm', 'Warm', 'Cool', 'Warm'],\n",
        "                        'Forecast':['Same', 'Same', 'Change', 'Change', 'Change'],\n",
        "                            'EnjoySport':['Yes', 'Yes', 'No', 'Yes', 'Yes']\n",
        "                            }\n",
        "\n",
        "                            df = pd.DataFrame(data)\n",
        "\n",
        "                            print(\"Training Dataset:\")\n",
        "                            display(df)\n",
        "\n",
        "                            # ---------------------------------------------------\n",
        "                            # STEP 2: FIND-S Algorithm\n",
        "                            # ---------------------------------------------------\n",
        "\n",
        "                            def find_s(data):\n",
        "                                attributes = data.columns[:-1]\n",
        "                                    target = data.columns[-1]\n",
        "\n",
        "                                        # Initialize hypothesis with the most specific values\n",
        "                                            hypothesis = ['Ø'] * len(attributes)\n",
        "\n",
        "                                                print(\"\\nFIND-S Algorithm Steps:\")\n",
        "                                                    print(\"Initial Hypothesis:\", hypothesis)\n",
        "\n",
        "                                                        # Process each training example\n",
        "                                                            for index, row in data.iterrows():\n",
        "\n",
        "                                                                    # Consider only positive examples\n",
        "                                                                            if row[target] == 'Yes':\n",
        "\n",
        "                                                                                        for i, attribute in enumerate(attributes):\n",
        "\n",
        "                                                                                                        # If hypothesis is still most specific\n",
        "                                                                                                                        if hypothesis[i] == 'Ø':\n",
        "                                                                                                                                            hypothesis[i] = row[attribute]\n",
        "\n",
        "                                                                                                                                                            # If values are different, generalize\n",
        "                                                                                                                                                                            elif hypothesis[i] != row[attribute]:\n",
        "                                                                                                                                                                                                hypothesis[i] = '?'\n",
        "\n",
        "                                                                                                                                                                                                            print(f\"After positive example {index + 1}: {hypothesis}\")\n",
        "\n",
        "                                                                                                                                                                                                                return hypothesis\n",
        "\n",
        "\n",
        "                                                                                                                                                                                                                # Find the most specific hypothesis\n",
        "                                                                                                                                                                                                                final_hypothesis = find_s(df)\n",
        "\n",
        "                                                                                                                                                                                                                print(\"\\nFinal Most Specific Hypothesis:\")\n",
        "                                                                                                                                                                                                                print(final_hypothesis)"
      ]
